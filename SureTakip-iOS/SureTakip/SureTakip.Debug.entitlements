<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode builds run against the APNs sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Groups deliberately left out: the Developer Portal App ID doesn't
	     have it enabled yet (removed during TestFlight troubleshooting), and
	     declaring it here without that would fail signing. WidgetStore.swift
	     already falls back to standard UserDefaults when the App Group suite
	     isn't available, so nothing breaks - re-add both here and on the App ID
	     when the home-screen widget actually gets built. -->
</dict>
</plist>
